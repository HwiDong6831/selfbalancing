/*
 * Spring 서버 주소. localhost 가 아니라 "서버 PC 의 LAN IP" 여야 한다.
 * Windows 에서 확인: ipconfig → IPv4 주소
 */
#define SERVER_WS_URI   "ws://192.168.0.10:8080/ws/esp"
