/*
 * secrets.h.example — 이 파일을 secrets.h 로 복사한 뒤 실제 값으로 채운다.
 *
 *   cp main/secrets.h.example main/secrets.h
 *
 * secrets.h 는 .gitignore 에 등록돼 있어 커밋되지 않는다.
 */
#pragma once

#define WIFI_SSID       "여기에_공유기_SSID"
